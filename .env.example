# ── Supabase (Project Settings → API) ─────────────────────────────
# Public project URL and the *anon/publishable* key. Both are safe to
# ship to the browser because every table is protected by RLS.
# NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Site ──────────────────────────────────────────────────────────
# Canonical production origin, no trailing slash. Used for canonical
# URLs, Open Graph tags, sitemap.xml and the password-reset redirect.
VITE_SITE_URL=https://your-domain.com

# Storage bucket name created by the migrations (keep the default).
VITE_SUPABASE_MEDIA_BUCKET=media
